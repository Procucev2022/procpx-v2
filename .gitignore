# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# local structured logs, snapshots, and screenshots
/logs

# next.js
/.next/
/out/

# generated application builds
/dist/
/.output/
/.turbo/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare local state and secrets
/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# local databases and SQLite sidecars (D1 schema and SQL migrations stay tracked)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal

# local caches and scratch output
/.cache/
/.npm/
/tmp/
/temp/
/.tmp-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp profiles and scratch
.chrome-tmp/
temp-edge-profile*/
scratch/

