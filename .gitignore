# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and CI reports
/coverage
/playwright-report/
/test-results/
/blob-report/
/ci-reports/

# local structured logs, snapshots, and screenshots
/logs

# next.js
.next/
/out/

# generated application builds
/dist/
/.output/
/.turbo/
/.swc/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare: OpenNext build output, local Wrangler/D1 state, and local secrets
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases and SQLite sidecars (D1 schema and SQL migrations stay tracked)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal

# database backups and generated integrity snapshots
/prisma/backups/

# OCR language data downloaded and cached at runtime by tesseract.js
*.traineddata

# spreadsheets downloaded from the app into the project root
/*.xlsx
/*.xls
/*.csv

# local caches, temp profiles, and scratch output
/.cache/
/.npm/
/tmp/
/temp/
/.tmp-*
.chrome-tmp/
temp-edge-profile*/
scratch/
/scratch-*

# user-uploaded files (keep the sample template only)
/uploads/*
!/uploads/sample_boq_upload.xlsx

# local screenshots and previews
/scripts/*.png

# generated Prisma client output (the workerClient generator writes here on every `prisma generate`)
/generated/
