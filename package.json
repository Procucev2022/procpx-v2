{
  "name": "procpx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "db:integrity": "node scripts/run-db-integrity.cjs",
    "db:migrate:safe": "node scripts/apply-pending-migrations.cjs",
    "logs:search": "node scripts/manage-logs.cjs search",
    "logs:purge": "node scripts/manage-logs.cjs purge",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "node scripts/run-unit-coverage.cjs",
    "coverage:report": "node scripts/write-unit-coverage-report.cjs",
    "test:watch": "jest --watch --detectOpenHandles",
    "check:i18n": "node scripts/check-ui-strings.cjs",
    "check:quality": "node scripts/check-quality.cjs",
    "check:changed": "node scripts/check-changed.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.3.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.52.0",
    "multer": "^2.4.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.1",
    "playwright": "^1.64.1",
    "playwright-core": "^1.57.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
