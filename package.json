{
  "name": "procpx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.cjs",
    "dev:e2e": "npm run cf:build && wrangler dev --config wrangler.jsonc --persist-to .wrangler/e2e-d1 --port 3001",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "npm run cf:preview",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:migrate": "npm run db:d1:migrate:remote",
    "lint": "node scripts/check-lint-baseline.cjs",
    "lint:full": "eslint",
    "db:integrity": "node scripts/check-d1-integrity.cjs",
    "db:integrity:remote": "node scripts/check-d1-integrity.cjs --remote",
    "db:quality": "node scripts/report-d1-data-quality.cjs",
    "db:quality:remote": "node scripts/report-d1-data-quality.cjs --remote",
    "db:migrate:safe": "node scripts/apply-d1-migrations.cjs --local",
    "db:d1:migrate:remote": "node scripts/apply-d1-migrations.cjs --remote",
    "db:seed:test": "node scripts/seed-d1-test-fixtures.cjs",
    "db:seed:dev": "node scripts/seed-dev-mock-data.cjs",
    "logs:search": "node scripts/manage-logs.cjs search",
    "logs:purge": "node scripts/manage-logs.cjs purge",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "node scripts/run-unit-coverage.cjs",
    "coverage:report": "node scripts/write-unit-coverage-report.cjs",
    "test:watch": "jest --watch --detectOpenHandles",
    "check:i18n": "node scripts/check-ui-strings.cjs",
    "check:architecture": "node scripts/check-d1-mutation-boundaries.cjs",
    "check:performance": "node scripts/check-performance-budgets.cjs",
    "check:quality": "node scripts/check-quality.cjs",
    "check:changed": "node scripts/check-changed.cjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.11",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.156.0"
  }
}
