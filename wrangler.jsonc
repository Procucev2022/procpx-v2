// Cloudflare Workers deployment for proCPX (Next.js via OpenNext)
// Docs: https://opennext.js.org/cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procpx",
  "account_id": "97a5dd65ad21c0f5dcd8547de147c806",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "UPLOAD_DIR": "r2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "procpx-dev",
      "database_id": "ffb73313-6ac9-4306-87e9-751b6a0f6e81"
    }
  ]
  // Uploads: enable R2 in the Cloudflare dashboard, run
  //   npx wrangler r2 bucket create procpx-uploads
  // then add this block:
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "procpx-uploads" }]
}
