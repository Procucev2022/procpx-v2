{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procpx",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "UPLOAD_DIR": "r2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "procpx-dev",
      "database_id": "ffb73313-6ac9-4306-87e9-751b6a0f6e81",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "procpx-uploads"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "env": {
    "dev": {
      "name": "procpx",
      "vars": {
        "UPLOAD_DIR": "r2",
        "NEXTAUTH_URL": "https://procpx.anshul-goel.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "procpx-dev",
          "database_id": "ffb73313-6ac9-4306-87e9-751b6a0f6e81",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "procpx-uploads"
        }
      ]
    },
    // Used only by `npm run dev:remote` (next dev with PROCPX_DEV_REMOTE=true). Deploys and
    // migrations never select it. Bindings marked "remote": true reach the deployed procpx-dev
    // D1 database and R2 bucket from a local `next dev` process.
    "remote": {
      "account_id": "97a5dd65ad21c0f5dcd8547de147c806",
      "vars": {
        "UPLOAD_DIR": "r2"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "procpx-dev",
          "database_id": "ffb73313-6ac9-4306-87e9-751b6a0f6e81",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "procpx-uploads",
          "remote": true
        }
      ]
    },
    "prod": {
      "name": "procpx-prod",
      "vars": {
        "UPLOAD_DIR": "r2",
        "NEXTAUTH_URL": "https://procpx-prod.srinivas-mukku.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "procpx-prod",
          "database_id": "646df8db-22b5-4e86-8116-b6abbe0974be",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "procpx-uploads"
        }
      ]
    }
  }
}
