{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "procpx-d1",
  "compatibility_date": "2026-10-31",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "procpx-d1",
      "database_id": "replace-with-cloudflare-d1-database-id",
      "migrations_dir": "migrations"
    }
  ]
}
