NEXTAUTH_SECRET="procpx-super-secret-key-change-in-production-2024"
NEXTAUTH_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"

# Cloudflare credentials for the D1 HTTP adapter and Wrangler migrations.
# Copy these into an ignored local .env file, and set the same database ID in wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID="replace-with-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="replace-with-cloudflare-api-token"
CLOUDFLARE_DATABASE_ID="replace-with-cloudflare-d1-database-id"
