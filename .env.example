# All values below are REQUIRED. The app refuses to start (npm run dev and the server
# itself) if any are missing. Never commit the real .env file.

# Generate your own: openssl rand -base64 32 (use a different value per environment).
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Must match the address you open in the browser.
NEXTAUTH_URL="http://localhost:3000"
# Folder for uploaded files on local runs (Cloudflare uses the R2 bucket instead).
UPLOAD_DIR="./uploads"

# Database: always Cloudflare D1 (do not add DATABASE_URL).
#   npm run dev         -> local Wrangler D1 under .wrangler/
#   npm run dev:remote  -> the deployed procpx-dev D1 + R2 from wrangler.jsonc (needs `npx wrangler login`)
DATABASE_PROVIDER="d1"

# Google Gemini API key used for AI drawing extraction.
GEMINI_API_KEY="replace-with-gemini-api-key"

# Optional settings.
# OPENAI_API_KEY="replace-with-provider-key"
# GEMINI_MODEL="gemini-2.5-flash"
# OPENAI_MODEL="gpt-4o-mini"

# Optional: only needed for non-interactive Wrangler runs (CI) instead of `wrangler login`.
# CLOUDFLARE_ACCOUNT_ID="replace-with-cloudflare-account-id"
# CLOUDFLARE_API_TOKEN="replace-with-cloudflare-api-token"
# CLOUDFLARE_DATABASE_ID="replace-with-cloudflare-d1-database-id"
